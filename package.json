{
  "name": "dsh-essay-desk",
  "version": "0.2.0",
  "private": true,
  "description": "随笔工坊：在 Harness Web GUI 里写随笔、按主题归档、沉淀思想脉络，并每天写一道命题 · Essay desk: write essays, archive them into topic Markdown files, keep a thread of your thinking, and practice with a daily prompt.",
  "icon": "icon.svg",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
